---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ApplicationForm from '../../components/ApplicationForm.astro';
import { OPEN_POSITIONS } from '../../data/careers.js';
import { SITE } from '../../data/site.js';
import { localizePath } from '../../i18n/utils.js';

export function getStaticPaths() {
  return OPEN_POSITIONS.map((pos) => ({ params: { slug: pos.slug }, props: { pos } }));
}

const { pos } = Astro.props;
const lang = (Astro.currentLocale ?? 'en') as 'en' | 'es';
const base = import.meta.env.BASE_URL;
const path = (p: string) => `${base}${localizePath(p, lang).replace(/^\//, '')}`;

const title = lang === 'es' ? pos.titleEs : pos.title;
const location = lang === 'es' ? pos.locationEs : pos.location;
const type = lang === 'es' ? pos.typeEs : pos.type;
const description = lang === 'es' ? pos.descriptionEs : pos.description;
const aboutRole = lang === 'es' ? pos.aboutRoleEs : pos.aboutRole;
const responsibilities = lang === 'es' ? pos.responsibilitiesEs : pos.responsibilities;
const requirements = lang === 'es' ? pos.requirementsEs : pos.requirements;
const niceToHave = lang === 'es' ? pos.niceToHaveEs : pos.niceToHave;
const benefits = lang === 'es' ? pos.benefitsEs : pos.benefits;

const isClientSearch = pos.kind === 'client';
const isCampaign = pos.campaign === true;

const copy = {
  en: {
    eyebrow: isClientSearch ? 'Active Search' : 'Open Position',
    back: 'All open positions',
    aboutRoleH2: 'About the Role',
    responsibilitiesH2: isCampaign ? 'What We’re Looking For' : 'Key Responsibilities',
    requirementsH2: 'Requirements',
    niceToHaveH2: isCampaign ? 'Good to Know' : 'Nice to Have',
    benefitsH2: isCampaign ? 'How This Works' : 'What We Offer',
    formEyebrow: 'Apply',
    formH2: `Apply for ${title}`,
    formLede: 'Tell us about yourself and attach your résumé — we review every application personally.',
    metaDescription: `${title} at Altura Talent Partners — ${location}, ${type}. ${description}`,
    holdBadge: 'On Hold',
    holdEyebrow: 'On Hold',
    holdH2: 'This search is currently on hold',
    holdBody: 'We’re not accepting new applications for this role right now. Feel free to check back later, or explore our other open positions.',
    holdCta: 'View all open positions',
  },
  es: {
    eyebrow: isClientSearch ? 'Búsqueda Activa' : 'Posición Abierta',
    back: 'Todas las posiciones abiertas',
    aboutRoleH2: 'Sobre el Rol',
    responsibilitiesH2: isCampaign ? 'Qué Estamos Buscando' : 'Responsabilidades Principales',
    requirementsH2: 'Requisitos',
    niceToHaveH2: isCampaign ? 'Para Tener en Cuenta' : 'Deseable',
    benefitsH2: isCampaign ? 'Cómo Funciona' : 'Qué Ofrecemos',
    formEyebrow: 'Postúlate',
    formH2: `Postúlate para ${title}`,
    formLede: 'Cuéntanos sobre ti y adjunta tu CV — revisamos cada postulación de forma personal.',
    metaDescription: `${title} en Altura Talent Partners — ${location}, ${type}. ${description}`,
    holdBadge: 'En Pausa',
    holdEyebrow: 'En Pausa',
    holdH2: 'Esta búsqueda está en pausa',
    holdBody: 'En este momento no estamos aceptando nuevas postulaciones para este rol. Podés volver a revisar más adelante, o explorar nuestras otras vacantes abiertas.',
    holdCta: 'Ver todas las vacantes abiertas',
  },
}[lang];

const defaultInterestLabel = isCampaign
  ? lang === 'es'
    ? 'Búsquedas para clientes — Tecnología'
    : 'Client searches — Technology'
  : undefined;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title,
  description,
  identifier: {
    '@type': 'PropertyValue',
    name: SITE.name,
    value: pos.slug,
  },
  datePosted: pos.datePosted,
  employmentType: /Full-time|Indefinite/.test(pos.type) ? 'FULL_TIME' : pos.type,
  hiringOrganization: {
    '@type': 'Organization',
    name: SITE.name,
    sameAs: SITE.url,
  },
  jobLocationType: pos.location.includes('Remote') ? 'TELECOMMUTE' : 'ONSITE',
  applicantLocationRequirements: {
    '@type': 'Country',
    name: pos.country ?? 'Americas',
  },
};
---

<Layout title={title} description={copy.metaDescription} schema={schema}>
  <section class="page-hero section-sm">
    <div class="container container-narrow">
      <a href={path('careers/')} class="back-link">
        <Icon name="arrowRight" size={14} />
        <span>{copy.back}</span>
      </a>
      <div class="eyebrow-row">
        <span class="eyebrow">{copy.eyebrow}</span>
        {pos.onHold && <span class="hold-badge">{copy.holdBadge}</span>}
      </div>
      <h1>{title}</h1>
      <div class="job-meta">
        <span><Icon name="pin" size={16} /> {location}</span>
        <span><Icon name="briefcase" size={16} /> {type}</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container container-narrow">
      <p class="lede">{aboutRole}</p>

      <h2>{copy.responsibilitiesH2}</h2>
      <ul class="job-list">
        {responsibilities.map((item) => (
          <li><Icon name="check" size={15} /><span>{item}</span></li>
        ))}
      </ul>

      <h2>{copy.requirementsH2}</h2>
      <ul class="job-list">
        {requirements.map((item) => (
          <li><Icon name="check" size={15} /><span>{item}</span></li>
        ))}
      </ul>

      <h2>{copy.niceToHaveH2}</h2>
      <ul class="job-list">
        {niceToHave.map((item) => (
          <li><Icon name="check" size={15} /><span>{item}</span></li>
        ))}
      </ul>

      <h2>{copy.benefitsH2}</h2>
      <ul class="job-list">
        {benefits.map((item) => (
          <li><Icon name="check" size={15} /><span>{item}</span></li>
        ))}
      </ul>
    </div>
  </section>

  {pos.onHold ? (
    <section class="section section-gray" id="apply">
      <div class="container container-narrow">
        <div class="section-header text-center mx-auto hold-notice">
          <span class="eyebrow">{copy.holdEyebrow}</span>
          <h2>{copy.holdH2}</h2>
          <p class="lede mx-auto">{copy.holdBody}</p>
          <a href={path('careers/')} class="btn btn-ghost">{copy.holdCta} <Icon name="arrowRight" size={14} /></a>
        </div>
      </div>
    </section>
  ) : (
    <section class="section section-gray" id="apply">
      <div class="container container-narrow">
        <div class="section-header text-center mx-auto">
          <span class="eyebrow">{copy.formEyebrow}</span>
          <h2>{copy.formH2}</h2>
          <p class="lede mx-auto">{copy.formLede}</p>
        </div>
        <ApplicationForm lang={lang} defaultRoleSlug={isCampaign ? undefined : pos.slug} defaultInterestLabel={defaultInterestLabel} />
      </div>
    </section>
  )}
</Layout>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-ink-500);
    margin-bottom: 1.5rem;
    transform: scaleX(-1);
  }
  .back-link span {
    transform: scaleX(-1);
  }
  .back-link:hover {
    color: var(--color-accent);
  }

  .eyebrow-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .hold-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--color-gray-50);
    border: 1px solid var(--color-ink-200);
    color: var(--color-ink-500);
    font-size: var(--fs-2xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .hold-notice .btn {
    margin-top: 1.5rem;
  }

  .job-meta {
    display: flex;
    gap: 1.5rem;
    margin-top: 1.25rem;
  }
  .job-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--color-ink-500);
  }

  .section h2 {
    margin-top: 2.25rem;
    margin-bottom: 1rem;
  }
  .section h2:first-of-type {
    margin-top: 0.5rem;
  }

  .job-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .job-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: var(--fs-sm);
    color: var(--color-ink-700);
    line-height: 1.55;
  }
  .job-list li :global(svg) {
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--color-accent);
  }

  .section-header {
    max-width: 640px;
    margin-bottom: 3rem;
  }
  .section-header .eyebrow {
    margin-bottom: 1rem;
  }
  .section-header h2 {
    margin: 1rem 0;
  }
</style>
